{% set summary = "Tests " ~ repo_name ~ "'s backend and frontend in a Kubernetes Job, then builds the " ~ backend_image ~ " and " ~ frontend_image ~ " images and pins them into " ~ (deploy_repo.split('/') | last) ~ ", which Argo CD syncs to prd." %}
// {{ summary | wordwrap(97, break_on_hyphens=False, wrapstring="\n// ") }}
//
// The images are built from the tree the suite passed on, so `latest` is tagged at build time and
// there is no promote stage.
//
// Controller config:
//   - Job: {{ repo_name }}
//   - SCM: {{ github_owner }}/{{ repo_name }}, branch main
//   - Script Path: Jenkinsfile

library identifier: 'JenkinsPipelineUtils', changelog: false

pipeline {
    agent {
        kubernetes {
            inheritFrom 'jenkins-agent kaniko'
            yamlMergeStrategy merge()
            yaml podYaml(templates: ['k8s'])
        }
    }

    options {
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout()
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                script {
{% if use_database or use_s3 %}
                    // The services are containers in the Job's pod and start with the suite, so the
                    // suite runner waits for them (backend/scripts/wait-for-services.py).
{% endif %}
{% if use_database %}
                    // PostgreSQL is a sidecar so that both suites, pytest and Playwright, have a
                    // server to create and drop their databases on, at the default
                    // TEST_DATABASE_ADMIN_URL. Its major version is production's.
{% endif %}
{% if use_s3 %}
                    // S3 comes from a RustFS sidecar rather than shared storage: the backend's test
                    // fixtures abort without a real S3 API, and a throwaway bucket per run keeps
                    // builds from tripping over each other. The backend creates the bucket itself.
{% endif %}
                    modernApp.test(
                        job: '{{ project_name }}-validation',
                        install: 'uv sync --locked --no-dev',
                        run: 'uv run --no-sync',
                        suites: ['backend', 'frontend'],
{% if use_database or use_s3 %}
                        services: [
{% if use_database %}
                            [name: 'postgres', image: 'postgres:18-trixie', env: [
                                POSTGRES_PASSWORD: 'postgres',
                            ]],
{% endif %}
{% if use_s3 %}
                            [name: 's3storage', image: 'rustfs/rustfs:latest', env: [
                                RUSTFS_ACCESS_KEY: 's3storage',
                                RUSTFS_SECRET_KEY: 's3storage',
                            ]],
{% endif %}
                        ],
{% else %}
                        services: [],
{% endif %}
                        env: [
                            // CI is the tst tier; under testing STAGE would default to local-tst.
                            STAGE: 'tst',
                            // The library fixes run-suite's flags, so the suite runner's pnpm store
                            // cache is switched on here instead of with --build-cache.
                            BUILD_CACHE: 'true',
{% if use_s3 %}
                            S3_ENDPOINT_URL: 'http://localhost:9000',
                            S3_ACCESS_KEY_ID: 's3storage',
                            S3_SECRET_ACCESS_KEY: 's3storage',
                            S3_BUCKET_NAME: '{{ project_name }}-validation',
{% endif %}
                        ],
                        secrets: [],
                    )
                }
            }
        }

        stage('Build {{ backend_image }} image') {
            steps {
                container('kaniko') {
                    script {
                        helmCharts.kaniko2(
                            dockerfile: 'backend/Dockerfile',
                            context: 'backend',
                            destinations: [
                                "registry:5000/{{ backend_image }}:${currentBuild.number}",
                                'registry:5000/{{ backend_image }}:latest',
                            ]
                        )
                    }
                }
            }
        }

        stage('Build {{ frontend_image }} image') {
            steps {
                // The frontend shows the commit it was built from, and its build context holds no
                // .git to read it from.
                sh 'git rev-parse HEAD > frontend/git-rev'
                container('kaniko') {
                    script {
                        helmCharts.kaniko2(
                            dockerfile: 'frontend/Dockerfile',
                            context: 'frontend',
                            destinations: [
                                "registry:5000/{{ frontend_image }}:${currentBuild.number}",
                                'registry:5000/{{ frontend_image }}:latest',
                            ]
                        )
                    }
                }
            }
        }

        stage('Write image pins') {
            steps {
                container('k8s') {
                    script {
                        cicd.writeVersionPins(repo: '{{ deploy_repo }}', pins: [
                            'config/prd/values.yaml': [
                                'images.{{ backend_image_pin_key }}': ":${currentBuild.number}",
                                'images.{{ frontend_image_pin_key }}': ":${currentBuild.number}",
                            ],
                        ])
                    }
                }
            }
        }
    }
}
