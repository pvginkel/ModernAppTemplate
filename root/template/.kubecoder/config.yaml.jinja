# KubeCoder environment manifest for the {{ repo_name }} monorepo.
#
# One sidecar rather than `python` + `frontend`: the Playwright harness boots the
# Flask backend{% if use_sse %} and the SSE gateway{% endif %} per worker
# (frontend/tests/support/process/servers.ts), so a single command needs both
# toolsets in the same container.
{% if use_database or use_s3 %}
#
{% endif %}
{% if use_database %}
# `postgres` serves the dev stack's database: the backend's default
# DATABASE_URL points at localhost:5432/{{ database_name }}, and `kc project setup`
# creates that database and applies the migrations. The backend suite and
# Playwright (a clone of a seed database per worker) create their own
# databases on the same server (TEST_DATABASE_ADMIN_URL) and never touch the
# dev one.
{% endif %}
{% if use_s3 %}
# `s3storage` (RustFS) provides S3 on localhost:9000, credentials
# s3storage/s3storage, storage cleared on every start: the backend test fixtures
# hard-fail when S3_ENDPOINT_URL is unreachable, and create their bucket. CI
# runs the same RustFS image as a sidecar in the validation Job (Jenkinsfile,
# "Run validation").
{% endif %}
#
# No imageBuilder: both Dockerfiles are built by Jenkins with
# helmCharts.kaniko(...), and nothing builds an image from inside this
# environment.

repos:
  # The AI workflow's spec repository, shared across every environment that
  # works on {{ repo_name }}.
  - url: https://github.com/{{ github_owner }}/{{ repo_name }}Specs
    shared: true

capabilities:
  github: rw

tools:
  - use: modern-app
  # arch-validate, for the architecture model's lint step (project.yaml); the
  # AaC/{{ repo_name }} job runs the same command.
  - use: aac-tools
{% if use_database or use_s3 %}

services:
{% if use_database %}
  - postgres
{% endif %}
{% if use_s3 %}
  - s3storage
{% endif %}
{% endif %}

ports:
  - name: frontend
    port: {{ frontend_port }}
    type: http
    sslOffload: true
  - name: backend
    port: {{ backend_port }}
    type: http
{% if use_sse %}
  - name: sse-gateway
    port: {{ sse_gateway_port }}
    type: http
{% endif %}
